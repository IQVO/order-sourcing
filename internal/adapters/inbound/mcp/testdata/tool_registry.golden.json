      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "List fulfillment assignments, ordered by assignmentId ascending: which vendor node and path will fulfil each shipment group of a customer order, in which state (QUEUED, RELEASED, LOCKED, SHIPPED, DELIVERED, UNSOURCEABLE, CANCELLED). Filters combine with AND and are all optional: state, orderId, and nodeId (the current candidate node while QUEUED, the node of the latest release later). Each item carries the promise constraint, the lines, the current candidate with its cost, the releaseAt point and a cap of limit items (default 100, maximum 500). Read-only; an unknown state or a limit outside 1..500 fails with validation-failed.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "optional page size, 1..500; omitted or 0 means the default of 100",
          "type": "integer"
        },
        "nodeId": {
          "description": "optional filter: keep only assignments currently on this node (the QUEUED candidate's node, or the node of the latest release); omitted means every node",
          "type": "string"
        },
        "orderId": {
          "description": "optional filter: keep only assignments of this order; omitted means every order",
          "type": "string"
        },
        "state": {
          "description": "optional filter: keep only assignments in this state, one of QUEUED, RELEASED, LOCKED, SHIPPED, DELIVERED, UNSOURCEABLE or CANCELLED; omitted means every state",
          "type": "string"
        }
      },
      "type": "object"
    },
